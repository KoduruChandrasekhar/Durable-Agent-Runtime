{
 "uid": "keel-engine",
 "title": "keel \u00b7 engine health",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Runs by state",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "keel_pending_runs",
     "legendFormat": "pending"
    },
    {
     "refId": "B",
     "expr": "keel_running_runs",
     "legendFormat": "running"
    },
    {
     "refId": "C",
     "expr": "keel_waiting_runs",
     "legendFormat": "waiting"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Runs finished /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(keel_runs_finished_total[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Steps completed /s (workers)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(keel_worker_steps_total[1m]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Queue wait p50 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(keel_queue_wait_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum(rate(keel_queue_wait_seconds_bucket[1m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Workers alive \u00b7 active runs",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up{job='keel-worker'} == 1)",
     "legendFormat": "workers up"
    },
    {
     "refId": "B",
     "expr": "sum(keel_worker_active_runs)",
     "legendFormat": "active runs"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Lease expirations \u00b7 fencing rejections /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(keel_lease_expirations_total[1m])",
     "legendFormat": "lease expirations"
    },
    {
     "refId": "B",
     "expr": "rate(keel_fencing_rejections_total[1m])",
     "legendFormat": "fencing rejections"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Recoveries (claims by reason) /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(keel_claims_total[1m]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Replay duration p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum(rate(keel_replay_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Step retries /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(keel_step_retries_total[1m])",
     "legendFormat": "retries"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Leader",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "keel_leader",
     "legendFormat": "{{instance}}"
    }
   ]
  }
 ],
 "tags": [
  "keel"
 ]
}