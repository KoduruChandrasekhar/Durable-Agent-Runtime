{
 "uid": "keel-cost",
 "title": "keel \u00b7 cost",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "LLM spend $/h by tenant",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant) (rate(keel_llm_cost_usd_total[5m])) * 3600",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Tokens /s by model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, direction) (rate(keel_llm_tokens_total[1m]))",
     "legendFormat": "{{model}} {{direction}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Cache hits /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(keel_cache_hits_total[1m]))",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Budget rejections /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant) (rate(keel_budget_rejections_total[1m]))",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Gateway requests by outcome /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, outcome) (rate(keel_gateway_requests_total[1m]))",
     "legendFormat": "{{model}} {{outcome}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Retries and fallbacks /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(keel_gateway_retries_total[1m]))",
     "legendFormat": "retries"
    },
    {
     "refId": "B",
     "expr": "sum(rate(keel_gateway_fallbacks_total[1m]))",
     "legendFormat": "fallbacks"
    },
    {
     "refId": "C",
     "expr": "rate(keel_gateway_escalations_total[1m])",
     "legendFormat": "escalations"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Circuit open",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "keel_circuit_open",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Wasted tokens (crash during an LLM call)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(keel_wasted_llm_tokens_total[5m]))",
     "legendFormat": "wasted tokens / 5m"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Gateway overhead p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum(rate(keel_gateway_overhead_seconds_bucket[1m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Tenant spend today",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "keel_tenant_spend_usd",
     "legendFormat": "{{tenant}}"
    }
   ]
  }
 ],
 "tags": [
  "keel"
 ]
}