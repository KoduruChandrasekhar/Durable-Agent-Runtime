{
 "uid": "keel-agent",
 "title": "keel \u00b7 agent behaviour",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Policy decisions /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(keel_policy_decisions_total[1m]))",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Policy decisions by rule",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (rule) (increase(keel_policy_decisions_total[5m]))",
     "legendFormat": "{{rule}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Approvals pending",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "keel_approvals_pending",
     "legendFormat": "pending"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Step duration p99 by kind",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum(rate(keel_step_duration_seconds_bucket[1m])) by (le, kind))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Run duration p50 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(keel_run_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum(rate(keel_run_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Sandbox executions /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(keel_sandbox_executions_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Events appended /s by type",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(keel_events_appended_total[1m]))",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Outbox deliveries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(keel_outbox_messages_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  }
 ],
 "tags": [
  "keel"
 ]
}